{
  "description": "Reuse matching Codex context, route durable goals with user control, refresh changed chapters through the current host, and record completed progress locally.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/run-prompt-hook.sh\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\run-plugin-node.ps1\" -Mode prompt",
            "additionalContextLimit": 600,
            "async": false,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/run-stop-hook.sh\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\run-plugin-node.ps1\" -Mode stop",
            "statusMessage": "Updating task status…",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
